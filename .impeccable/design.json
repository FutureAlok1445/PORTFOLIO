  "narrative": {
    "northStar": "AFTER HOURS — the personal engineering workshop",
    "overview": "Alok’s engineering work lives in one personal after-hours workshop. Warm paper, deep ink, matte miniature objects and restrained amber/steel light connect the real person to inspectable project evidence. The name, engineering statement, portrait and work/resume actions lead; the desk and quiet charcoal companion support them.\n\nThis is the owner-pinned Experience direction implemented in code, with no approved image comp. The surface composition and quality bar remain in `.impeccable/surfaces/after-hours-home.md`. The workshop is a metaphor, not a claim about Alok’s physical room; Patch is an original fictional companion. Project illustrations describe workflows and must not imply application screenshots or unverified results.",
    "keyCharacteristics": [
      "One procedural matte desk on eligible desktop browsers, with immediate authored vector fallback.",
      "Self-hosted editorial serif headings and clear sans-serif body/interface text.",
      "Distinct source-grounded artifacts, warm notebook pages, tactile tool keys and compact archive rows.",
      "Native phone scrolling, semantic controls, visible focus and readable reduced-motion states."
    ],
    "rules": [
      {
        "name": "The Material Rule",
        "body": "Object colors stay local to their artwork; shared text and controls use semantic theme colors.",
        "section": "neutral"
      },
      {
        "name": "The Meaningful Label Rule",
        "body": "Labels identify real domains, sources, states or location/time. Avoid redundant lead-ins above already clear headings.",
        "section": "typography"
      },
      {
        "name": "The Readable First Rule",
        "body": "Critical copy and actions render immediately; motion and the scene never gate access to content.",
        "section": "layout"
      },
      {
        "name": "The Local Depth Rule",
        "body": "Keep dimensional treatments on meaningful workshop objects; do not spread 3D canvases or heavy shadows across ordinary copy.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the pinned workshop world, self-hosted fonts and semantic theme mappings.",
      "Do keep all twelve artifacts equally discoverable and source-grounded.",
      "Do edit content and project facts only in `src/data/content.js`.",
      "Do keep semantic text, keyboard controls, visible focus, touch access and reduced-motion final states.",
      "Do preserve one eligible route-scoped Lenis instance, native phone scrolling and complete resource cleanup."
    ],
    "donts": [
      "Don't invent clients, dates, awards, testimonials, metrics, project links or application screenshots.",
      "Don't infer authorship, deployment or production readiness from repository existence.",
      "Don't obscure meaningful artwork labels or reintroduce redundant heading eyebrows.",
      "Don't expose TODO slots, link missing credentials or report form success before service success.",
      "Don't publish without owner authorization."
