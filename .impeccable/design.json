  "narrative": {
    "northStar": "AFTER HOURS — the world is the interface",
    "overview": "Alok's personal engineering workshop uses walnut furniture, midnight walls, warm paper, frost-blue displays and amber practical light. The original identity, truthful portfolio, self-hosted fonts and editorial Quick View remain. The owner's 3.0 direction intentionally extends this material world into object-owned reading surfaces: operating a prop opens its monitor, paper, terminal, board or stationery, with semantic HTML aligned to the actual surface.\r\n\r\nThe workshop is a visual metaphor rather than a claim about Alok's physical room. Patch is an original fictional character. Project illustrations represent source-grounded workflows and do not imply application screenshots or unverified results. The approved repair extends this same identity into a bounded cutaway room, a dimensional day/night window, genuinely free camera controls and a grounded voxel Patch. It preserves the existing visual direction; historical implementation reports describe their original snapshots only.",
    "keyCharacteristics": [
      "One persistent procedural matte room on eligible desktop browsers.",
      "Crisp semantic text on meaningful physical surfaces, with a touch-oriented 2.5D handoff.",
      "Self-hosted editorial serif and clear sans-serif interface type.",
      "Complete Quick View, direct case routes, visible focus and reduced-motion access."
    ],
    "rules": [
      {
        "name": "The Material Rule",
        "body": "Use warm paper for physical reading and cool ink displays for operational interfaces. Object artwork may use local material colors; readable text must retain the surface's semantic contrast.",
        "section": "colors"
      },
      {
        "name": "The Meaningful Label Rule",
        "body": "Labels identify real actions, records or states. Do not substitute pseudo-writing strokes for useful content or add redundant heading lead-ins.",
        "section": "typography"
      },
      {
        "name": "The Shared Access Rule",
        "body": "Every substantive object action has a semantic keyboard and touch path. No project, evidence or contact route is available only through a mesh hit.",
        "section": "layout"
      },
      {
        "name": "The Finite Response Rule",
        "body": "Deliberate interactions move, explain their state and settle. Avoid perpetual gallery rotation, camera wandering or decorative signal wallpaper.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the original identity, truthful facts, self-hosted fonts and material relationships.",
      "Do keep content and project facts in `src/data/content.js`.",
      "Do keep all twelve cases, direct work/resume actions and complete Quick View access.",
      "Do preserve keyboard focus, touch access, reduced-motion states and complete cleanup.",
      "Do distinguish local measured evidence from physical-device or service guarantees."
    ],
    "donts": [
      "Don't invent clients, dates, awards, testimonials, metrics, links or screenshots.",
      "Don't replace object-owned reading with detached generic side panels.",
      "Don't expose TODO slots, link absent credentials or report form success before service acceptance.",
      "Don't treat conceptual artwork or repository existence as proof of production capability.",
      "Don't commit, push, merge or publish this upgrade without owner authorization."
    ]
  }
}
